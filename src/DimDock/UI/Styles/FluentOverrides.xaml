<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Unified single-column Fluent MenuItem style (fixes .NET 10 Fluent's jagged 2-column checkmark+icon indent) -->
    <Style x:Key="DimDockMenuItemStyle" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource DimTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource DimDockMenuItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="HighlightBorder"
                                Margin="4,1"
                                Padding="10,6,12,6"
                                CornerRadius="4"
                                Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Single shared icon / checkmark slot -->
                                <ContentPresenter x:Name="IconHost"
                                                  Grid.Column="0"
                                                  ContentSource="Icon"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0" />

                                <TextBlock x:Name="CheckGlyph"
                                           Grid.Column="0"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="1,1,10,0"
                                           Visibility="Collapsed" />

                                <!-- Item label -->
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />

                                <!-- Submenu chevron -->
                                <TextBlock x:Name="SubmenuChevron"
                                           Grid.Column="2"
                                           Text="&#xE76C;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{DynamicResource DimTextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="18,1,0,0"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!-- Submenu Popup -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Right"
                               HorizontalOffset="2"
                               VerticalOffset="-5"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Margin="6"
                                    Padding="0,4"
                                    CornerRadius="8"
                                    MinWidth="148"
                                    Background="{DynamicResource DimMenuPopupBgBrush}"
                                    BorderBrush="{DynamicResource DimMenuPopupBorderBrush}"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000"
                                                      Opacity="0.45"
                                                      BlurRadius="14"
                                                      ShadowDepth="3"
                                                      Direction="270" />
                                </Border.Effect>
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuChevron" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="HighlightBorder" Property="Background" Value="{DynamicResource DimButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimal icon toggle button for Footer Link/Sync -->
    <Style x:Key="DimDockFooterToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource DimTextMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource DimButtonHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DimTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DimAccentBrush}" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource DimButtonHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
