<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CubicEase x:Key="DimSwitchEase" EasingMode="EaseOut" />

    <!-- Clean Windows 11 native taskbar ContextMenu container -->
    <Style x:Key="DimDockContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource DimDockMenuItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="8"
                            Padding="0,3"
                            CornerRadius="8"
                            MinWidth="216"
                            Background="{DynamicResource DimMenuPopupBgBrush}"
                            BorderBrush="{DynamicResource DimMenuPopupBorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              Opacity="0.45"
                                              BlurRadius="14"
                                              ShadowDepth="3"
                                              Direction="270" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DimDockSeparatorStyle" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Background="{DynamicResource DimMenuPopupBorderBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Native taskbar-style MenuItem with Fluent toggle switches, radio indicators, and zero blank left gutter -->
    <Style x:Key="DimDockMenuItemStyle" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource DimTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource DimDockMenuItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="HighlightBorder"
                                Margin="4,1"
                                Padding="10,6,12,6"
                                CornerRadius="4"
                                Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon slot for all top-level items -->
                                <ContentPresenter x:Name="IconHost"
                                                  Grid.Column="0"
                                                  ContentSource="Icon"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0" />

                                <!-- Real Windows 11 Fluent Radio indicator (for submenu Tag="radio" items) -->
                                <Grid x:Name="RadioVisual"
                                      Grid.Column="0"
                                      Width="14"
                                      Height="14"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed">
                                    <Ellipse x:Name="RadioOuter"
                                             Width="14"
                                             Height="14"
                                             Stroke="{DynamicResource DimTextMutedBrush}"
                                             StrokeThickness="1"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="RadioInner"
                                             Width="6"
                                             Height="6"
                                             Fill="{DynamicResource DimAccentForegroundBrush}"
                                             Visibility="Collapsed" />
                                </Grid>

                                <!-- Item label -->
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />

                                <!-- Windows 11 Fluent Pill Toggle Switch (for Tag="switch" items) -->
                                <Border x:Name="SwitchTrack"
                                        Grid.Column="2"
                                        Width="34"
                                        Height="18"
                                        CornerRadius="9"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource DimTextMutedBrush}"
                                        Background="Transparent"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0"
                                        Visibility="Collapsed">
                                    <Ellipse x:Name="SwitchKnob"
                                             Width="10"
                                             Height="10"
                                             Fill="{DynamicResource DimTextSecondaryBrush}"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Margin="3,0,0,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="SwitchKnobSlide" X="0" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>

                                <!-- Submenu chevron -->
                                <TextBlock x:Name="SubmenuChevron"
                                           Grid.Column="2"
                                           Text="&#xE76C;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{DynamicResource DimTextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="18,1,0,0"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!-- Submenu Popup -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Right"
                               HorizontalOffset="-4"
                               VerticalOffset="-11"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Margin="8"
                                    Padding="0,3"
                                    CornerRadius="8"
                                    MinWidth="148"
                                    Background="{DynamicResource DimMenuPopupBgBrush}"
                                    BorderBrush="{DynamicResource DimMenuPopupBorderBrush}"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000"
                                                      Opacity="0.45"
                                                      BlurRadius="14"
                                                      ShadowDepth="3"
                                                      Direction="270" />
                                </Border.Effect>
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Pill switch items (Tag="switch") -->
                        <Trigger Property="Tag" Value="switch">
                            <Setter TargetName="SwitchTrack" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="switch" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource DimAccentBrush}" />
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource DimAccentBrush}" />
                            <Setter TargetName="SwitchKnob" Property="Fill" Value="{DynamicResource DimAccentForegroundBrush}" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobSlide"
                                                         Storyboard.TargetProperty="X"
                                                         To="16"
                                                         Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource DimSwitchEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobSlide"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource DimSwitchEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!-- Radio-style submenu options (Tag="radio") -->
                        <Trigger Property="Tag" Value="radio">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RadioVisual" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="radio" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RadioOuter" Property="Fill" Value="{DynamicResource DimAccentBrush}" />
                            <Setter TargetName="RadioOuter" Property="Stroke" Value="{DynamicResource DimAccentBrush}" />
                            <Setter TargetName="RadioInner" Property="Visibility" Value="Visible" />
                        </MultiTrigger>

                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuChevron" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="HighlightBorder" Property="Background" Value="{DynamicResource DimButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimal icon toggle button for Footer Link/Sync -->
    <Style x:Key="DimDockFooterToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource DimTextMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource DimButtonHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DimTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DimAccentBrush}" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource DimButtonHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
