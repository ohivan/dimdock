<Window x:Class="DimDock.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DimDock"
        Width="356"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Deactivated="OnWindowDeactivated"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Border x:Name="RootSurface"
            Background="Transparent"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <!-- Main Body (WinUI 3 AcrylicBackgroundFillColorDefault: DWM Acrylic + subtle tint + 2% noise) -->
            <Grid Grid.Row="0"
                  Background="{DynamicResource DimFlyoutTintBrush}">
                <Rectangle Fill="{DynamicResource DimAcrylicNoiseBrush}"
                           IsHitTestVisible="False" />
                <ScrollViewer MaxHeight="420"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="20,18,20,0">
                        <!-- Populated Monitor Rows -->
                        <ItemsControl x:Name="MonitorsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12"
                                          Background="Transparent"
                                          PreviewMouseWheel="OnMonitorRowMouseWheel">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Monitor Icon + Name -->
                                        <StackPanel Grid.Row="0"
                                                    Orientation="Horizontal"
                                                    Margin="0,0,0,4">
                                            <TextBlock Text="&#xE7F4;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="20"
                                                       Foreground="{DynamicResource DimTextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="14.5"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource DimTextPrimaryBrush}"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="270" />
                                        </StackPanel>

                                        <!-- Lightweight Fluent Slider + Numeric Readout -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="46" />
                                            </Grid.ColumnDefinitions>

                                            <Slider Grid.Column="0"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    IsSnapToTickEnabled="True"
                                                    TickFrequency="1"
                                                    IsMoveToPointEnabled="True"
                                                    VerticalAlignment="Center"
                                                    Value="{Binding Brightness, Mode=OneWay}"
                                                    PreviewMouseLeftButtonDown="OnSliderPreviewMouseLeftButtonDown"
                                                    ValueChanged="OnSliderValueChanged" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Brightness}"
                                                       FontSize="20"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource DimTextPrimaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,0,1"
                                                       Typography.NumeralAlignment="Tabular" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State -->
                        <StackPanel x:Name="EmptyStatePanel"
                                    Visibility="Collapsed"
                                    Margin="0,6,0,14"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7F4;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="26"
                                       Foreground="{DynamicResource DimTextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="No DDC/CI monitors detected"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DimTextPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Ensure DDC/CI is enabled in your monitor's OSD menu."
                                       FontSize="12"
                                       Foreground="{DynamicResource DimTextMutedBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <Button Content="Refresh monitors"
                                    HorizontalAlignment="Center"
                                    Click="OnRefreshButtonClick" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- 1px Translucent Divider -->
            <Border Grid.Row="1"
                    Background="{DynamicResource DimDividerBrush}" />

            <!-- 48px Footer (WinUI 3 AcrylicBackgroundFillColorBase + 2% noise; 1px + 48px = 49px matching Quick Settings) -->
            <Grid Grid.Row="2"
                  Background="{DynamicResource DimFooterTintBrush}">
                <Rectangle Fill="{DynamicResource DimAcrylicNoiseBrush}"
                           IsHitTestVisible="False" />
                <Grid Margin="20,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Adjust Brightness"
                               FontSize="13"
                               Foreground="{DynamicResource DimTextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,0,2" />

                    <ToggleButton x:Name="LinkToggleButton"
                                  Grid.Column="1"
                                  Style="{StaticResource DimDockFooterToggleStyle}"
                                  ToolTip="Link all monitors"
                                  Click="OnLinkToggleClicked">
                        <TextBlock Text="&#xE71B;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" />
                    </ToggleButton>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
