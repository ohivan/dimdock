<Window x:Class="DimDock.UI.TrayToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Margin="8"
            Padding="12,6"
            CornerRadius="6"
            Background="{DynamicResource DimToastBgBrush}"
            BorderBrush="{DynamicResource DimToastBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Opacity="0.45"
                              BlurRadius="12"
                              ShadowDepth="2"
                              Direction="270" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="DimDock"
                       FontSize="13.5"
                       FontWeight="Normal"
                       Foreground="{DynamicResource DimTextPrimaryBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="PercentText"
                       Text="(50%)"
                       FontSize="12"
                       Foreground="{DynamicResource DimTextSecondaryBrush}"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular" />
        </StackPanel>
    </Border>
</Window>
