<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DimDock</AssemblyName>
    <RootNamespace>DimDock</RootNamespace>
    <Product>DimDock</Product>
    <Description>Lightweight Windows 11 system tray DDC/CI monitor brightness manager</Description>
    <Version>1.0.0</Version>
    <Authors>ohivan</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\NoiseAsset_256x256.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DimDock.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
